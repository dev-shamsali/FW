{
  "name": "@rheajs/core",
  "version": "0.1.0-alpha.2",
  "description": "Secure, convention-driven backend framework core for Node.js and Express. Made by Shams Ali Shaikh.",
  "keywords": [
    "rhea",
    "rheajs",
    "express",
    "express5",
    "nodejs",
    "backend",
    "framework",
    "typescript",
    "security",
    "api",
    "rest"
  ],
  "homepage": "https://rhea.devcodehub.cloud",
  "author": "Shams Ali Shaikh",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-shamsali/FW.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/dev-shamsali/FW/issues"
  }
}
