{
  "name": "@rheajs/cli",
  "version": "0.1.0-alpha.0",
  "description": "Rhea.js command line interface. Made by Shams Ali Shaikh.",
  "keywords": [
    "rhea",
    "rheajs",
    "cli",
    "generator",
    "scaffold",
    "express",
    "typescript",
    "nodejs"
  ],
  "homepage": "https://rhea.devcodehub.cloud",
  "author": "Shams Ali Shaikh",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rhea": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/bin.js',0o755)\"",
    "prepublishOnly": "npm run build"
  }
}
