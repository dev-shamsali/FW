{
  "name": "create-rhea",
  "version": "0.1.0-alpha.0",
  "description": "npx create-rhea my-api. Scaffolds a Rhea.js project. Made by Shams Ali Shaikh.",
  "keywords": [
    "rhea",
    "rheajs",
    "create",
    "scaffold",
    "generator",
    "express",
    "typescript",
    "nodejs"
  ],
  "homepage": "https://rhea.devcodehub.cloud",
  "author": "Shams Ali Shaikh",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "create-rhea": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/bin.js',0o755)\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@rheajs/cli": "0.1.0-alpha.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-shamsali/framework-rhea.js.git",
    "directory": "packages/create-rhea"
  },
  "bugs": {
    "url": "https://github.com/dev-shamsali/framework-rhea.js/issues"
  }
}
